<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard - Jurnal Trade</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/sidebar', { active: 'dashboard' }) %><main class="main"><header class="topbar"><button class="menu-toggle">☰</button><div><p class="eyebrow">JURNAL TRADE FUTURES</p><h1>Dashboard</h1></div><button class="avatar">I</button></header><section class="stats"><article><span>Total payout</span><strong>$<%= totals.payout.toFixed(2) %></strong><small><%= payouts.length %> transaksi</small></article><article><span>Total pengeluaran</span><strong>$<%= totals.expense.toFixed(2) %></strong><small><%= expenses.length %> transaksi</small></article><article><span>Net profit</span><strong class="positive">$<%= (totals.payout - totals.expense).toFixed(2) %></strong><small>Payout dikurangi pengeluaran</small></article><article><span>Akun aktif</span><strong><%= accounts.filter(row => row.status === 'ACTIVE').length %></strong><small><%= accounts.length %> total akun</small></article></section><% const sections = [{ key: 'accounts', title: 'Akun prop firm', cols: ['Prop firm','Account ID','Balance','Tanggal','Harga','Status'], rows: accounts }, { key: 'payouts', title: 'Riwayat payout', cols: ['Broker','Pengajuan','Konfirmasi','Payout total','Net payout','Siklus'], rows: payouts }, { key: 'expenses', title: 'Pengeluaran', cols: ['Prop firm','Balance','Tanggal','Harga','Status'], rows: expenses }]; %><% sections.forEach(section => { %><section class="panel"><div class="panel-heading"><div><h2><%= section.title %></h2><p>Data tersimpan di PostgreSQL.</p></div><a class="primary" href="/<%= section.key %>">Kelola</a></div><div class="table-wrap"><table><thead><tr><th>No.</th><% section.cols.forEach(col => { %><th><%= col %></th><% }) %></tr></thead><tbody><% section.rows.forEach((row, index) => { %><tr><td><%= index + 1 %></td><% Object.entries(row).filter(([key]) => key !== 'id').forEach(([, value]) => { %><td><%= value ?? '' %></td><% }) %></tr><% }) %><% if (!section.rows.length) { %><tr><td colspan="<%= section.cols.length + 1 %>">Belum ada data.</td></tr><% } %></tbody></table></div></section><% }) %></main><script src="/app.js"></script></body></html>