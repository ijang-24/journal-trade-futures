<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> - Jurnal Trade</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/sidebar',{active}) %><main class="main"><header class="topbar"><button class="menu-toggle">☰</button><div><p class="eyebrow">JURNAL TRADE FUTURES</p><h1><%= title %></h1></div><button class="avatar">I</button></header><section class="panel"><div class="panel-heading"><div><h2><%= heading %></h2><p><%= description %></p></div></div><form class="data-form" method="post" action="/<%= active %>"><% if(active==='accounts'){ %><input name="prop_firm" placeholder="Prop firm" required><input name="account_id" placeholder="Account ID" required><input name="balance" type="number" step=".01" placeholder="Balance" required><input name="trade_date" type="date" required><input name="price" type="number" step=".01" placeholder="Harga" required><select name="status"><option>ACTIVE</option><option>EVAL</option><option>FUNDED</option><option>FAILED</option><option>BLOWN</option></select><% } else if(active==='payouts'){ %><input name="broker" placeholder="Broker" required><input name="submission_date" type="date" required><input name="confirmation_date" type="date"><input name="payout_total" type="number" step=".01" placeholder="Payout total" required><input name="net_payout" type="number" step=".01" placeholder="Net payout" required><input name="cycle" type="number" min="0" placeholder="Cycle" required><% } else { %><input name="prop_firm" placeholder="Prop firm" required><input name="balance" type="number" step=".01" placeholder="Balance" required><input name="expense_date" type="date" required><input name="price" type="number" step=".01" placeholder="Harga" required><select name="status"><option>FAILED</option><option>EVAL</option><option>ACTIVE</option><option>FUNDED</option><option>BLOWN</option></select><% } %><button class="primary" type="submit">Tambah</button></form><div class="table-wrap"><table><thead><tr><th>No.</th><% columns.forEach(c=>{ %><th><%= c %></th><% }) %><th>Aksi</th></tr></thead><tbody><% rows.forEach((row,index)=>{ %><tr><td><%= index+1 %></td><% if(active==='accounts'){ %><td><input name="prop_firm" value="<%= row.prop_firm %>" required></td><td><input name="account_id" value="<%= row.account_id %>" required></td><td><input name="balance" type="number" step=".01" value="<%= row.balance %>" required></td><td><input name="trade_date" type="date" value="<%= String(row.trade_date).slice(0,10) %>" required></td><td><input name="price" type="number" step=".01" value="<%= row.price %>" required></td><td><select name="status"><% ['ACTIVE','EVAL','FUNDED','FAILED','BLOWN'].forEach(s=>{ %><option <%= row.status===s?'selected':'' %>><%= s %></option><% }) %></select></td><% } else if(active==='payouts'){ %><td><input name="broker" value="<%= row.broker %>" required></td><td><input name="submission_date" type="date" value="<%= String(row.submission_date).slice(0,10) %>" required></td><td><input name="confirmation_date" type="date" value="<%= row.confirmation_date ? String(row.confirmation_date).slice(0,10) : '' %>"></td><td><input name="payout_total" type="number" step=".01" value="<%= row.payout_total %>" required></td><td><input name="net_payout" type="number" step=".01" value="<%= row.net_payout %>" required></td><td><input name="cycle" type="number" min="0" value="<%= row.cycle %>" required></td><% } else { %><td><input name="prop_firm" value="<%= row.prop_firm %>" required></td><td><input name="balance" type="number" step=".01" value="<%= row.balance %>" required></td><td><input name="expense_date" type="date" value="<%= String(row.expense_date).slice(0,10) %>" required></td><td><input name="price" type="number" step=".01" value="<%= row.price %>" required></td><td><select name="status"><% ['FAILED','EVAL','ACTIVE','FUNDED','BLOWN'].forEach(s=>{ %><option <%= row.status===s?'selected':'' %>><%= s %></option><% }) %></select></td><% } %><td><form id="edit-<%= row.id %>" method="post" action="/<%= active %>/<%= row.id %>/edit" class="edit-row"><button class="primary" type="submit">Simpan</button></form><form method="post" action="/<%= active %>/<%= row.id %>/delete" style="display:inline"><button class="delete" type="submit">×</button></form></td></tr><% }) %></tbody></table></div></section></main><script src="/app.js"></script></body></html>