<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> - Jurnal Trade</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/sidebar', { active }) %><main class="main"><header class="topbar"><button class="menu-toggle">☰</button><div><p class="eyebrow">SUNDAY, 20 SEPTEMBER 2026</p><h1><%= title %></h1></div><button class="avatar">I</button></header><section class="panel"><div class="panel-heading"><div><h2><%= heading %></h2><p><%= description %></p></div></div><form class="data-form" method="post" action="/<%= active %>"><% if (active === 'accounts') { %><input name="prop_firm" placeholder="Prop firm" required><input name="account_id" placeholder="Account ID" required><input name="balance" type="number" step="0.01" placeholder="Balance" required><input name="trade_date" type="date" required><input name="price" type="number" step="0.01" placeholder="Harga" required><select name="status"><option>ACTIVE</option><option>EVAL</option><option>FUNDED</option><option>FAILED</option><option>BLOWN</option></select><button class="primary" type="submit">Tambah</button><% } else if (active === 'payouts') { %><input name="broker" placeholder="Broker" required><input name="submission_date" type="date" required><input name="confirmation_date" type="date"><input name="payout_total" type="number" step="0.01" placeholder="Payout total" required><input name="net_payout" type="number" step="0.01" placeholder="Net payout" required><input name="cycle" type="number" min="0" placeholder="Cycle" required><button class="primary" type="submit">Tambah</button><% } else { %><input name="prop_firm" placeholder="Prop firm" required><input name="balance" type="number" step="0.01" placeholder="Balance" required><input name="expense_date" type="date" required><input name="price" type="number" step="0.01" placeholder="Harga" required><select name="status"><option>FAILED</option><option>EVAL</option><option>ACTIVE</option><option>FUNDED</option><option>BLOWN</option></select><button class="primary" type="submit">Tambah</button><% } %></form><div class="table-wrap"><table><thead><tr><% columns.forEach(column => { %><th><%= column %></th><% }) %></tr></thead><tbody><% rows.forEach((row, index) => { %><tr><td><%= index + 1 %></td><% Object.entries(row).filter(([key]) => key !== 'id').forEach(([, value]) => { %><td><%= value ?? '' %></td><% }) %></tr><% }) %></tbody></table></div></section></main><script src="/app.js"></script></body></html>