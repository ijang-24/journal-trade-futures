<!doctype html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> - Jurnal Trade</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/sidebar', { active }) %><main class="main"><header class="topbar"><button class="menu-toggle">☰</button><div><p class="eyebrow">SUNDAY, 20 SEPTEMBER 2026</p><h1><%= title %></h1></div><button class="avatar">I</button></header><section class="panel"><div class="panel-heading"><div><h2><%= heading %></h2><p><%= description %></p></div><button class="primary" id="add-row"><%= button %></button></div><div class="table-wrap"><table id="account-table"><thead><tr><% columns.forEach(column => { %><th><%= column %></th><% }) %></tr></thead><tbody><% rows.forEach((row, rowIndex) => { %><tr><% row.forEach((cell, cellIndex) => { %><td<% if (cellIndex > 0 && editable) { %> contenteditable="true"<% } %>><%= cell %></td><% }) %></tr><% }) %></tbody></table></div></section></main><script src="/app.js"></script></body></html>
